{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    // Mirrors WXT's `@` alias relative to the project root. The shadcn CLI
    // resolves aliases from here; without this it writes files to `../`.
    "paths": {
      "@": ["."],
      "@/*": ["./*"]
    }
  }
}
